# The stock SD card image (1.9 GB): keep it, but not in git
backup/

# Built game packages (made by deploy.sh / run.sh)
build/

# The LÖVE app used to run games on the Mac: downloaded, not ours
tools/love.app/

# Kernel build output (make rebuilds these)
bare-metal/kernel/*.o
bare-metal/kernel/kernel.elf
bare-metal/kernel/kernel.img
bare-metal/kernel/uboot.img
bare-metal/monitor/*.o
bare-metal/monitor/monitor.elf
bare-metal/monitor/monitor.bin
bare-metal/monitor/trust.img

# Ghidra's project database: big and changes on every open. The blob and our
# labelling script are tracked; the project can be rebuilt from them.
bare-metal/ddr-blob/ghidra/

# A clone of Rockchip's U-Boot, for reading only (it's its own git repo)
bare-metal/ddr-blob/u-boot-src/

.lsp
.DS_Store
._*
__pycache__/
bare-metal/spl/*.o
bare-metal/spl/spl.elf
bare-metal/spl/spl.bin
bare-metal/spl/idbloader.img
bare-metal/ddr/*.o
bare-metal/ddr/ddr.elf
bare-metal/ddr/ddr.bin
bare-metal/spl/idbloader-ours.img

# Boot ROM and RAM dumps: Rockchip code, kept local only
bare-metal/kernel/dumps/

# Mesa source clone (built by build-mesa.sh), its own repo
bare-metal/gpu/mesa
